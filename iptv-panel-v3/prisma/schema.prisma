generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESELLER
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum ServerType {
  XTREAM
  STALKER
  M3U
}

enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum FirewallRuleType {
  WHITELIST
  BLACKLIST
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  username          String     @unique
  password          String
  role              Role       @default(RESELLER)
  status            UserStatus @default(ACTIVE)
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?
  credits           Float      @default(0)
  resellerId        String?
  reseller          User?      @relation("ResellerClients", fields: [resellerId], references: [id])
  clients           User[]     @relation("ResellerClients")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  iptvClients       Client[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  invoices          Invoice[]
  apiKeys           ApiKey[]

  @@index([email])
  @@index([resellerId])
}

model Client {
  id              String     @id @default(uuid())
  username        String     @unique
  password        String
  m3uUrl          String?
  xtreamHost      String?
  status          UserStatus @default(ACTIVE)
  maxConnections  Int        @default(1)
  expiresAt       DateTime
  lastSeen        DateTime?
  deviceCount     Int        @default(0)
  notes           String?
  bouquets        String[]

  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  serverId        String?
  server          Server?    @relation(fields: [serverId], references: [id])

  planId          String?
  plan            Plan?      @relation(fields: [planId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  invoices        Invoice[]
  sharingAlerts   SharingAlert[]
  magDevices      MagDevice[]
  enigma2Devices  Enigma2Device[]

  @@index([ownerId])
  @@index([status])
  @@index([expiresAt])
}

model Plan {
  id             String   @id @default(uuid())
  name           String
  description    String?
  durationDays   Int
  maxConnections Int      @default(1)
  price          Float
  bouquets       String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients        Client[]
}

model Server {
  id            String       @id @default(uuid())
  name          String
  url           String
  type          ServerType   @default(XTREAM)
  username      String?
  password      String?
  status        ServerStatus @default(ONLINE)
  uptime        Float        @default(100)
  activeStreams  Int          @default(0)
  maxStreams     Int          @default(1000)
  bandwidthMbps Float        @default(0)
  location      String?
  lastChecked   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  clients       Client[]
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  amount        Float
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([status])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String?  @unique
  ip           String
  userAgent    String?
  device       String?
  lastActive   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

model FirewallRule {
  id        String           @id @default(uuid())
  type      FirewallRuleType
  value     String
  reason    String?
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([type, value])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  key         String    @unique
  lastUsed    DateTime?
  permissions String[]
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([key])
  @@index([userId])
}

model SharingAlert {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ips       String[]
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

enum StreamType {
  LIVE
  MOVIE
  SERIES
  RADIO
}

enum StreamStatus {
  ONLINE
  OFFLINE
  STOPPED
  STARTING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model StreamCategory {
  id          String      @id @default(uuid())
  name        String
  type        StreamType  @default(LIVE)
  icon        String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  streams     Stream[]
  movies      Movie[]
  series      Series[]
  radios      RadioStream[]
}

model Stream {
  id              String        @id @default(uuid())
  name            String
  streamUrl       String
  icon            String?
  epgChannelId    String?
  status          StreamStatus  @default(ONLINE)
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  notes           String?
  tvgId           String?
  tvgName         String?
  inputBandwidth  Float         @default(0)
  outputBandwidth Float         @default(0)
  currentViewers  Int           @default(0)
  transcodeProfileId String?
  transcodeProfile   TranscodeProfile? @relation(fields: [transcodeProfileId], references: [id])
  categoryId      String?
  category        StreamCategory? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
}

model Movie {
  id           String        @id @default(uuid())
  name         String
  streamUrl    String
  icon         String?
  description  String?
  releaseYear  Int?
  rating       Float?
  duration     Int?
  tmdbId       String?
  genre        String[]
  isActive     Boolean       @default(true)
  views        Int           @default(0)
  categoryId   String?
  category     StreamCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
}

model Series {
  id           String        @id @default(uuid())
  name         String
  icon         String?
  description  String?
  releaseYear  Int?
  rating       Float?
  tmdbId       String?
  genre        String[]
  isActive     Boolean       @default(true)
  categoryId   String?
  category     StreamCategory? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  episodes     Episode[]

  @@index([categoryId])
}

model Episode {
  id         String   @id @default(uuid())
  title      String
  streamUrl  String
  season     Int      @default(1)
  episode    Int      @default(1)
  duration   Int?
  tmdbId     String?
  seriesId   String
  series     Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([seriesId])
}

model RadioStream {
  id         String        @id @default(uuid())
  name       String
  streamUrl  String
  icon       String?
  country    String?
  language   String?
  genre      String?
  isActive   Boolean       @default(true)
  categoryId String?
  category   StreamCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model EpgSource {
  id        String   @id @default(uuid())
  name      String
  url       String
  isActive  Boolean  @default(true)
  lastFetch DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TranscodeProfile {
  id         String   @id @default(uuid())
  name       String   @unique
  videoCodec String   @default("copy")
  audioCodec String   @default("copy")
  resolution String?
  bitrate    String?
  extraArgs  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  streams    Stream[]
}

model MagDevice {
  id           String   @id @default(uuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  macAddress   String   @unique
  model        String?
  imageVersion String?
  ipAddress    String?
  lastSeen     DateTime?
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
}

model Enigma2Device {
  id           String   @id @default(uuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  macAddress   String   @unique
  model        String?
  ipAddress    String?
  lastSeen     DateTime?
  isActive     Boolean  @default(true)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId])
}

model SupportTicket {
  id          String         @id @default(uuid())
  subject     String
  message     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  clientName  String?
  clientEmail String?
  assignedTo  String?
  response    String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CreditLog {
  id            String   @id @default(uuid())
  userId        String
  amount        Float
  type          String
  description   String?
  balanceBefore Float
  balanceAfter  Float
  createdAt     DateTime @default(now())

  @@index([userId])
}

model LiveConnection {
  id          String   @id @default(uuid())
  clientId    String?
  username    String
  ipAddress   String
  userAgent   String?
  streamName  String?
  country     String?
  bandwidth   Float    @default(0)
  connectedAt DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([clientId])
}

model UserAgentBlock {
  id        String   @id @default(uuid())
  pattern   String   @unique
  reason    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model IsrBlock {
  id        String   @id @default(uuid())
  country   String?
  isp       String?
  reason    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
