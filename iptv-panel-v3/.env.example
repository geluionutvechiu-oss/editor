# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://iptv_user:secret123@localhost:5432/iptv_panel
DB_PASSWORD=secret123

# ─── JWT Secrets (change these in production!) ──────────────
JWT_ACCESS_SECRET=change_me_to_a_random_32_char_string_1
JWT_REFRESH_SECRET=change_me_to_a_random_32_char_string_2

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── IPTV ───────────────────────────────────────────────────
# Default upstream server URL (used in M3U URLs and Xtream Codes API)
DEFAULT_SERVER_URL=http://your-iptv-server.com:8080

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@iptv-panel.com

# ─── Misc ───────────────────────────────────────────────────
LOG_LEVEL=info
DISABLE_JOBS=false
