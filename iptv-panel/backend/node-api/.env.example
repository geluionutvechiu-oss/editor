NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=iptv_user
DB_PASSWORD=your_secure_db_password
DB_NAME=iptv_panel
DB_POOL_SIZE=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT
JWT_SECRET=your_very_long_random_secret_key_at_least_64_chars_for_production_use
JWT_EXPIRY=24h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=info
LOG_DIR=/var/log/iptv

# TMDB API (optional, for metadata)
TMDB_API_KEY=your_tmdb_api_key_here
